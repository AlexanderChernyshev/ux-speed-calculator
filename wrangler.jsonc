{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ux-speed-calculator",
  "account_id": "724e55bcae2b4d037e3e85b1a4716da1",
  "main": "./.output/server/index.mjs",
  "compatibility_date": "2026-01-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  // Upload the Nitro build output as is. Nitro adds these same two settings to the config
  // it generates at build time; they're repeated here so this file alone can upload a
  // prebuilt output, as the PR preview workflow does (.github/workflows/preview-deploy.yml)
  "no_bundle": true,
  "rules": [{ "type": "ESModule", "globs": ["**/*.mjs", "**/*.js"] }],
  "assets": {
    "binding": "ASSETS",
    "directory": "./.output/public",
  },
  "routes": [
    {
      "pattern": "calculator.uxspeed.dev",
      "custom_domain": true,
    },
  ],
}
